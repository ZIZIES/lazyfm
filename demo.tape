Output demo.gif

Set FontFamily "JetBrainsMono Nerd Font"
Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 700
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms

# setup, hidden from the gif
Hide
Type `rm -rf /tmp/demo && mkdir -p "/tmp/demo/nuclear launch codes" "/tmp/demo/memes for later" "/tmp/demo/untitled folder 7" && cd /tmp/demo` Enter
Type `echo "no" > free-robux.txt && echo "hunter2" > passwords.txt && echo "- ship lazyfm" > todo.md` Enter
Type `printf "v 0 0 0\nv 1 0 0\n" > cube.obj && printf "MZ\000\000\000\000" > lib.obj` Enter
Type "clear" Enter
Show

Type "lazyfm"
Sleep 300ms
Enter
Sleep 1s

# scroll down through the folders
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms

# cube.obj (text, so it's a 3d model)
Type "j"
Sleep 1s

Type "j"
Sleep 300ms

# lib.obj (has NUL bytes, so it's an object file)
Type "j"
Sleep 1s

# cycle icon themes
Type "i"
Sleep 700ms
Type "i"
Sleep 700ms

# jump to the bottom file (todo.md), open the file menu
Type "G"
Sleep 500ms
Enter
Sleep 1s

# rename is 2 down
Type "j"
Sleep 200ms
Type "j"
Sleep 300ms
Enter
Sleep 400ms
Backspace 10
Type "tasks.md"
Sleep 300ms
Enter
Sleep 1s

# delete shows a confirm, say no
Type "m"
Sleep 400ms
Type "j"
Type "j"
Type "j"
Sleep 300ms
Enter
Sleep 1s
Type "n"
Sleep 800ms

# tabs
Type "n"
Sleep 700ms
Type "w"
Sleep 700ms

Type "q"
Sleep 300ms
